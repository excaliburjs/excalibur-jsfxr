{
  "name": "@excaliburjs/plugin-jsfxr",
  "version": "1.0.0-alpha.0",
  "description": "excalibur-jsfxr provides sound effect generation utilizing a wrapper around jsfxr",
  "repository": {
    "type": "git",
    "url": "https://github.com/excaliburjs/excalibur-jsfxr"
  },
  "main": "build/esm/excalibur-jsfxr.min.js",
  "types": "build/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/excalibur-jsfxr.js"
    }
  },
  "files": [
    "build",
    "readme.md",
    "LICENSE"
  ],
  "scripts": {
    "build:esm": "vite build && vite build --minify false",
    "build": "npm run build:esm && npm run types",
    "start": "vite example",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test": "npm run typecheck && npm run test:e2e"
  },
  "author": {
    "name": "Excalibur.js Team",
    "email": "excaliburjs@gmail.com",
    "url": "http://excaliburjs.com"
  },
  "license": "BSD-2-Clause",
  "keywords": [
    "excalibur",
    "game",
    "engine",
    "sfx",
    "jsfxr",
    "sound",
    "audio"
  ],
  "bugs": {
    "url": "https://github.com/excaliburjs/excalibur-jsfxr/issues"
  },
  "homepage": "https://github.com/excaliburjs/excalibur-jsfxr#readme",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.1",
    "copyfiles": "2.4.1",
    "excalibur": "0.33.0-alpha.274",
    "typescript": "5.9.3",
    "uglify-js": "^3.19.3",
    "vite": "8.1.4"
  },
  "peerDependencies": {
    "excalibur": ">=0.33.0-alpha.247"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": ">=11"
    }
  }
}
